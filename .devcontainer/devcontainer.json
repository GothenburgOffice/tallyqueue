{
  "name": "TallyQueue",
  // Reuses the Docker development stack; the extra file adds container-only settings.
  "dockerComposeFile": ["../compose.yaml", "../compose.dev.yaml", "compose.yaml"],
  "service": "app",
  "workspaceFolder": "/app",
  "runServices": ["app"],
  // Keep the service command: it starts the server, which restarts when the source changes.
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "charliermarsh.ruff",
        "github.vscode-github-actions",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.tabSize": 4
        }
      }
    }
  }
}
