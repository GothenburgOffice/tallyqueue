# Copy to .env next to the Compose file and fill in: cp .env.example .env
# (PowerShell: Copy-Item .env.example .env). Never commit .env.

# The address users type: HTTPS, no trailing slash, no path. Links in replies, the Host and
# Origin checks and the Secure flag on the session cookie all come from it.
PUBLIC_URL=https://tallyqueue.example.com
# The port on this machine that your reverse proxy forwards to.
APP_PORT=3440

# Approved users: name:sha256 pairs, comma-separated. Nobody else gets in, and with this
# empty nobody gets in at all. The server keeps only the SHA-256 of each token.
# Make a token and its pair (the token is shown once; keep it in a password manager):
#   docker compose run --rm app python -m tallyqueue token owner
TALLYQUEUE_USERS=

# Largest receipt file, in bytes (default 15 MB).
# MAX_RECEIPT_BYTES=15728640
# Where users of this server can get its source (AGPL section 13). Set it if you run a
# changed version; the default is this project's repository.
# SOURCE_URL=
# Optional for compose.images.yaml: pin a published sha-... tag or digest.
# TALLYQUEUE_IMAGE=ghcr.io/gothenburgoffice/tallyqueue:latest

# compose.caddy.yaml only: host ports, and where Caddy listens when that is not PUBLIC_URL
# itself, for example ":80" behind another HTTPS proxy. Users must still type PUBLIC_URL: the
# app refuses any other host name.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# SITE_ADDRESS=

# Development only (compose.dev.yaml and the dev container). The dev stack signs in with a
# public, made-up token (see compose.dev.yaml) and keeps its data in its own volume.
# DEV_PUBLIC_URL=http://localhost:3440
# DEV_TALLYQUEUE_USERS=
# Dev container only: where Claude Code's project memory lives on the host.
# Default: ~/.claude-memory/tallyqueue (Windows: %USERPROFILE%\.claude-memory\tallyqueue).
# CLAUDE_MEMORY_DIR=
